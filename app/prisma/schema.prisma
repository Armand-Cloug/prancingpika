// prisma/schema.prisma
//
// Schéma hybride PrancingPika + PrancingTurtle
// Philosophie :
//   - Stockage agrégé (pas d'event individuel) → compact comme PrancingPika
//   - Champs enrichis (aps, absorbed, overheal, blocked, deaths) → précision PT
//   - ability_id comme PK réelle du référentiel sorts → langue-neutre (PT)
//   - rosterHash pour les records par groupe (PrancingPika)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Instances (contenus de jeu : Bastion of Steel, IROTP, etc.)
// ─────────────────────────────────────────────────────────────────────────────
model Instance {
  id        BigInt @id @default(autoincrement())
  name      String @unique @db.VarChar(128)
  shortName String? @db.VarChar(32)

  bosses Boss[]

  @@map("instances")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bosses
// ─────────────────────────────────────────────────────────────────────────────
model Boss {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(128) // nom canonique anglais
  displayName String?   @db.VarChar(128)         // alias d'affichage si différent
  instanceId  BigInt?

  instance Instance? @relation(fields: [instanceId], references: [id])
  runs     Run[]

  @@index([instanceId])
  @@map("bosses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Abilities — référentiel des sorts
// id = ability_id du log Rift (field[8] du tuple) — langue-neutre, PAS autoincrement
// ─────────────────────────────────────────────────────────────────────────────
model Ability {
  id          BigInt  @id                        // ability_id Rift, PAS autoincrement
  name        String  @db.VarChar(128)           // premier nom vu (label, peut être FR/EN)
  damageType  String? @db.VarChar(32)            // "Physical", "Fire", etc. (normalisé EN)
  firstSeenAt DateTime @default(now())

  runPlayerAbilities RunPlayerAbility[]

  @@index([name])
  @@map("abilities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Groups (roster identifié par hash SHA-1)
// ─────────────────────────────────────────────────────────────────────────────
model Group {
  id         BigInt  @id @default(autoincrement())
  rosterHash String  @unique @db.Char(40)        // sha1 hex des noms triés
  rosterSize Int
  label      String? @db.VarChar(128)            // ex: "Nom du raid"

  runs Run[]

  @@map("groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// Players (personnages IG)
// ─────────────────────────────────────────────────────────────────────────────
model Player {
  id    BigInt  @id @default(autoincrement())
  name  String  @unique @db.VarChar(128)
  class String? @db.VarChar(32)                 // "Warrior", "Mage", etc.

  runPlayers         RunPlayer[]
  runDeaths          RunDeath[]

  @@map("players")
}

// ─────────────────────────────────────────────────────────────────────────────
// WebAccounts (comptes du site — Google / Discord)
// ─────────────────────────────────────────────────────────────────────────────
model WebAccount {
  id BigInt @id @default(autoincrement())

  provider          AuthProvider
  providerAccountId String @db.VarChar(128)
  pseudo            String @db.VarChar(128)
  email             String? @db.VarChar(191)
  imageUrl          String? @db.VarChar(255)
  createdAt         DateTime @default(now())
  lastLogin         DateTime @default(now())

  guildMemberships GuildMember[]
  uploadedRuns     Run[]

  @@unique([provider, providerAccountId])
  @@index([pseudo])
  @@map("web_accounts")
}

enum AuthProvider {
  google
  discord
}

// ─────────────────────────────────────────────────────────────────────────────
// Guilds
// ─────────────────────────────────────────────────────────────────────────────
model Guild {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(128)
  tag       String?  @unique @db.VarChar(16)
  createdAt DateTime @default(now())

  members GuildMember[]
  runs    Run[]

  @@map("guilds")
}

model GuildMember {
  guildId   BigInt
  accountId BigInt
  role      GuildRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  guild   Guild      @relation(fields: [guildId],   references: [id], onDelete: Cascade)
  account WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([guildId, accountId])
  @@index([accountId])
  @@index([guildId])
  @@map("guild_members")
}

enum GuildRole {
  OWNER
  OFFICER
  MEMBER
}

// ─────────────────────────────────────────────────────────────────────────────
// Runs — 1 ligne = 1 kill de boss
// ─────────────────────────────────────────────────────────────────────────────
model Run {
  id         BigInt @id @default(autoincrement())

  bossId     BigInt
  groupId    BigInt
  guildId    BigInt
  uploaderId BigInt

  startedAt DateTime
  endedAt   DateTime

  // Durées
  durationTotalS Int               // durée totale du combat (secondes)
  bossDurationS  Int?              // durée de la phase boss si différente (Titan X, Isiel)

  // Stats groupe
  totalDamage   BigInt
  totalHealing  BigInt
  totalAbsorbed BigInt @default(0) // NOUVEAU : absorptions (boucliers)

  dpsGroup Float
  hpsGroup Float
  apsGroup Float  @default(0)     // NOUVEAU : APS groupe

  logFile   String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  // Relations
  boss     Boss       @relation(fields: [bossId],     references: [id], onDelete: Restrict)
  group    Group      @relation(fields: [groupId],    references: [id], onDelete: Restrict)
  guild    Guild      @relation(fields: [guildId],    references: [id], onDelete: Restrict)
  uploader WebAccount @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  players RunPlayer[]
  deaths  RunDeath[]
  buffs   RunBuff[]

  // Index pour les leaderboards
  @@index([bossId])
  @@index([groupId])
  @@index([guildId])
  @@index([uploaderId])
  @@index([bossId, durationTotalS])          // WR global par boss (temps)
  @@index([bossId, groupId, durationTotalS]) // WR par boss+groupe
  @@index([guildId, bossId, durationTotalS]) // leaderboard guild
  @@index([uploaderId, createdAt])
  @@map("runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// RunPlayers — stats par joueur par run
// ─────────────────────────────────────────────────────────────────────────────
model RunPlayer {
  runId    BigInt
  playerId BigInt

  // Stats calculées (formule PT : amount + absorbed + blocked + ignored)
  damage   BigInt
  healing  BigInt
  absorbed BigInt @default(0)   // NOUVEAU : APS (absorptions posées)
  overheal BigInt @default(0)   // NOUVEAU : sursoins
  blocked  BigInt @default(0)   // NOUVEAU : dégâts bloqués cumulés

  // Rates
  dps Float
  hps Float
  aps Float @default(0)         // NOUVEAU

  role String? @db.VarChar(32)  // "DPS", "Healer", "Tank", "Support"
  spec String? @db.VarChar(64)  // Spec détectée, ex: "Spitfire", "Inquisitor"

  run    Run    @relation(fields: [runId],    references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  abilities RunPlayerAbility[]

  @@id([runId, playerId])
  @@index([playerId])
  @@index([runId, dps])
  @@index([runId, hps])
  @@index([runId, aps])
  @@map("run_players")
}

// ─────────────────────────────────────────────────────────────────────────────
// RunPlayerAbilities — détail par sort (agrégé, pas par event)
// abilityId = ability_id du log (field[8]) — langue-neutre
// ─────────────────────────────────────────────────────────────────────────────
model RunPlayerAbility {
  id BigInt @id @default(autoincrement())

  runId    BigInt
  playerId BigInt

  kind        AbilityKind @default(DAMAGE)

  // Clé canonique du sort (langue-neutre)
  abilityId   BigInt
  // Nom du sort tel que vu dans le log (label d'affichage seulement)
  abilityName String @db.VarChar(128)

  // Statistiques agrégées
  total    BigInt
  hits     Int
  critRate Float
  minHit   Int
  maxHit   Int
  avgHit   Float
  rate     Float    // DPS / HPS / APS de ce sort seul
  pct      Float    // % de contribution au total du joueur
  absorbed BigInt @default(0) // portion absorbée par les boucliers ennemis

  ability   Ability   @relation(fields: [abilityId],          references: [id], onDelete: Restrict)
  runPlayer RunPlayer @relation(fields: [runId, playerId],     references: [runId, playerId], onDelete: Cascade)

  @@unique([runId, playerId, kind, abilityId])
  @@index([runId, playerId])
  @@index([runId, kind])
  @@index([abilityId])
  @@map("run_player_abilities")
}

enum AbilityKind {
  DAMAGE
  HEAL
  ABSORB
}

// ─────────────────────────────────────────────────────────────────────────────
// RunDeaths — morts de joueurs (agrégées, pas par event)
// ─────────────────────────────────────────────────────────────────────────────
model RunDeath {
  id       BigInt @id @default(autoincrement())

  runId    BigInt
  playerId BigInt

  deathCount    Int      // nombre total de morts dans le fight
  firstDeathSec Int?     // seconde du premier décès (depuis début du fight)
  lastDeathSec  Int?     // seconde du dernier décès

  run    Run    @relation(fields: [runId],    references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([runId, playerId])
  @@index([runId])
  @@map("run_deaths")
}

// ─────────────────────────────────────────────────────────────────────────────
// RunBuffs — uptime des buffs raid (agrégé, pas par event)
// ─────────────────────────────────────────────────────────────────────────────
model RunBuff {
  id       BigInt @id @default(autoincrement())

  runId    BigInt

  buffName      String  @db.VarChar(128)
  totalUptimeSec Int
  uptimePct     Float   // % du fight où le buff était actif
  sourcePlayer  String? @db.VarChar(128) // joueur qui a posé le buff

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("run_buffs")
}
