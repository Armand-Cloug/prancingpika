# bot/Dockerfile
FROM node:22-alpine

WORKDIR /app

# Installe les deps
COPY package*.json ./
RUN npm ci --omit=dev

# Copie le code
COPY src ./src

ENV NODE_ENV=production
ENV PORT=8081

EXPOSE 8081

# (Optionnel) healthcheck simple via endpoint /health
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/health || exit 1

CMD ["node", "src/index.js"]